package ${package}.model.enums;

import lombok.AllArgsConstructor;
import lombok.Getter;

import java.util.Arrays;
import java.util.Map;
import java.util.function.Function;
import java.util.stream.Collectors;

public class ${className}Enums {

#foreach ($column in $columns)
    #if($column.enums && $column.enums.size() > 0)

        @Getter
        @AllArgsConstructor
        public enum ${column.attrName} {

#foreach ($enum in $column.enums)
            ${enum.constant}(${enum.code}, "${enum.name}")#if($velocityCount < $column.enums.size()),#end
#end
;

        private final Integer code;
        private final String name;
    }

    #end
#end

    public static <K, V> Map<K, V> toMap(Function<UserEnums.UserType, K> k, Function<UserEnums.UserType, V> v) {
        return Arrays.stream(UserEnums.UserType.values()).collect(Collectors.toMap(k, v));
    }
}
